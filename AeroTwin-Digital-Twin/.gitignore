.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.egg-info/
data/synthetic/
data/synthetic_pre_om*/
# The hazard-calibrated fleet: 445 MB of parquet, regenerated by
# scripts/generate_fleet.py from a seed. Same reasoning as data/synthetic/.
data/synthetic_hazard/
# data/models/ is DELIBERATELY NOT ignored below this line.
#
# It used to be, alongside the training scratch it sits next to -- and that
# was the wrong call for this one directory. rul_lstm.pt, tier2_extended.joblib,
# tier3.pt/tier3_edge*.onnx, survival_head.pkl and ood.npz are the TRAINED
# checkpoints layer3_ai/rul_serving.py, live.py and survival_serving.py load at
# fixed paths under data/models/ -- not regenerable from a seed the way
# data/synthetic/ is, and not third-party data the way data/benchmarks/ is.
# Without them a clone does not have a worse digital twin, it has none: the
# fault, RUL and survival heads have nothing to load and run.py's own
# quickstart says reproducing them is scripts/retrain_all.py and about an
# hour. 4.1 MB total, so there is no size reason to exclude it either.
#
# Backups stay excluded -- they are what retraining left behind, not what
# anything loads.
data/models_backup*/
data/replay/
data/twin_state/
!data/**/.gitkeep
certs/
*.db
*.sqlite3
.env

# Manufacturer documentation - large binaries, not ours to redistribute
engines manuals/

# Exported session transcripts - not part of the deliverable
all convo.txt
*convo*.txt
# Claude Code /export writes these with a date-stamped name.
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Generation logs and resume shards
data/synthetic/regen.*
data/**/_shards/

# Training logs
data/training_logs/

# Flight history: operational data recorded on a specific ground station,
# not project content. It is also the one store an operator would copy off
# a machine deliberately, so it must never leave via a commit by accident.
data/history/

# Signing keys, user store and first-run credentials - never committed
data/keys/
data/audit/

# Local server run artefacts
data/console.*

# Files set aside during the repository tidy rather than deleted outright:
# a different project's presentation, AI session transcripts, and a dead
# early prototype page. Kept locally so nothing is lost, out of the repo
# because none of it is a project artefact.
_attic/

# Scaffolding for handing the project to another AI session. Not project content.
AI_HANDOFF_PROMPT.md

# Last year's submission -- a DIFFERENT project (SIH 2025, PS SIH25179, quantum
# secure email). Kept on disk as a reference for deck STRUCTURE only; it is not
# part of this deliverable and must not travel with it.
Qumail PPT (SIH 2025).pdf

# Git-Bash crash dumps, not project content.
*.stackdump

# Third-party benchmark datasets. Downloaded on demand by
# scripts/fetch_benchmarks.py, never committed: 12 MB of NASA's bytes are not
# ours to redistribute, and docs/INDIGENISATION.md makes a claim about what
# this repository contains.
data/benchmarks/*
!data/benchmarks/.gitkeep
# ...but the MEASUREMENTS are ours and are the evidence behind the accuracy
# claims in docs/. The rule above is about not redistributing NASA's and
# NGAFID's bytes; it was sweeping up our own result files by accident. Only
# top-level results: `*` does not cross a `/`, so the extracted datasets in
# data/benchmarks/ngafid/ stay excluded.
!data/benchmarks/*.json
!data/benchmarks/*.jsonl

# Promo video. The Remotion SOURCE is kept -- src/, the diagrams and the
# voiceover audio are inputs that cannot be regenerated from anything else in
# here. The RENDERS are not: out/ is 51 MB of mp4 and stills/ 16 MB of frames,
# both reproducible with `npx remotion render`.
promo/out/
promo/stills/

# Recorded sorties. Generated by every run, regenerable, and 2.9 MB after a
# single afternoon of testing -- the same reasoning as data/synthetic/.
data/recordings/

# Scratch copy of data/ made by a previous run: 3.9 GB of benchmark archives
# and recordings, none of it source.
.runtime_data/

# Third-party datasets (NASA ACES and others): downloaded, never committed.
data/external/


# The demonstration bundle, rebuilt by deploy/demo/make_bundle.py
deploy/demo/out/
