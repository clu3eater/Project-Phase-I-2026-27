        <mxCell id="g56" value="RESILIENCE  ·  WHEN THE DATALINK DROPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#C87E10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="926" width="1568" height="80" as="geometry"/></mxCell>
        <mxCell id="m57" value="STORE AND FORWARD  |  LAST WILL" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="934" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k58" value="&lt;b&gt;The edge node keeps deciding and stores 72 hours of data.  On reconnect it forwards what the ground missed, and the broker reports any aircraft that went silent.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7F0;strokeColor=#C87E10;strokeWidth=1.5;fontSize=11;fontColor=#C87E10;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="32" y="964" width="1536" height="32" as="geometry"/></mxCell>
