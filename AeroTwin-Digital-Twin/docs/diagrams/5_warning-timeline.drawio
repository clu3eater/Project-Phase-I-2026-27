<mxfile host="app.diagrams.net" agent="PS26054" version="24.0.0">
  <diagram name="5 Warning Timeline" id="pg-5-warning-timeline">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr1" value="WHY THE WARNING ARRIVES EARLY  —  WEAR RAISES RISK  |  PS 26054" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="46" as="geometry"/></mxCell>
        <mxCell id="m2" value="PREDICTING PROBABLE FAILURES BEFORE OCCURRENCE" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#9DB4CC;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1154" y="13" width="430" height="20" as="geometry"/></mxCell>
        <mxCell id="g3" value="THE LIFE OF A DEVELOPING FAULT, LEFT TO RIGHT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#4551C0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="56" width="1568" height="254" as="geometry"/></mxCell>
        <mxCell id="m4" value="SAME ENGINE  |  SAME FLIGHT HOURS  |  TWO WAYS OF WATCHING IT" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="64" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k5" value="&lt;b&gt;Engine as-new&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;no measurable residual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF7F2;strokeColor=#1B9949;strokeWidth=1.5;fontSize=12;fontColor=#1B9949;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="26" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m6" value="risk: low" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#1B9949;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="26" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="k7" value="&lt;b&gt;Wear accumulates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;residuals begin to drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF7F2;strokeColor=#1B9949;strokeWidth=1.5;fontSize=12;fontColor=#1B9949;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="285" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m8" value="risk: rising" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#1B9949;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="285" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="k9" value="&lt;b&gt;Health index falls&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;trend detected, still serviceable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#286BCC;strokeWidth=1.5;fontSize=12;fontColor=#286BCC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="544" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m10" value="risk: climbing" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#286BCC;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="544" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="k11" value="&lt;b&gt;Fault begins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;identified by class and severity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF5EE;strokeColor=#C87E10;strokeWidth=1.5;fontSize=12;fontColor=#C87E10;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="803" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m12" value="risk: high" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#C87E10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="803" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="k13" value="&lt;b&gt;Advisory issued&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;action, deadline, evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F1F9;strokeColor=#773CAC;strokeWidth=1.5;fontSize=12;fontColor=#773CAC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1062" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m14" value="ACT HERE" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#773CAC;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1062" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="k15" value="&lt;b&gt;Failure avoided&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;engine serviced on the ground&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F6;strokeColor=#0E9E8C;strokeWidth=1.5;fontSize=12;fontColor=#0E9E8C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1321" y="98" width="238" height="104" as="geometry"/></mxCell>
        <mxCell id="m16" value="—" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#0E9E8C;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1321" y="206" width="238" height="16" as="geometry"/></mxCell>
        <mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k7" target="k9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k9" target="k11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k11" target="k13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k13" target="k15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k22" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8899AB;strokeColor=#8899AB;strokeWidth=1.5;fontSize=8;fontColor=#8899AB;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="32" y="246" width="1533" height="14" as="geometry"/></mxCell>
        <mxCell id="m23" value="FLIGHT HOURS ACCUMULATE  -&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#44566B;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="32" y="268" width="700" height="18" as="geometry"/></mxCell>
        <mxCell id="m24" value="END OF USEFUL LIFE" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="865" y="268" width="700" height="18" as="geometry"/></mxCell>
        <mxCell id="g25" value="CONVENTIONAL MONITORING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#C0392B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="326" width="774" height="150" as="geometry"/></mxCell>
        <mxCell id="m26" value="REACTIVE" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="426" y="334" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k27" value="&lt;b&gt;Sees nothing until a reading crosses a fixed limit, which happens at the far right of this timeline.  By then the damage is done, and the aircraft may already be airborne.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF5F4;strokeColor=#C0392B;strokeWidth=1.5;fontSize=12;fontColor=#C0392B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="32" y="372" width="742" height="88" as="geometry"/></mxCell>
        <mxCell id="g28" value="DIGITAL TWIN WITH A WEAR-OUT MODEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#0D8B7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="810" y="326" width="774" height="150" as="geometry"/></mxCell>
        <mxCell id="m29" value="PREDICTIVE" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="334" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k30" value="&lt;b&gt;Sees the residual drift from the second stage onward, and reports a rising probability of failure while the engine is still serviceable and on the ground.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8F7;strokeColor=#0D8B7C;strokeWidth=1.5;fontSize=12;fontColor=#0D8B7C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="826" y="372" width="742" height="88" as="geometry"/></mxCell>
        <mxCell id="g31" value="WHY THIS WORKS  —  DEGRADATION IS MODELLED AS A PROCESS WITH A RATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#4551C0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="492" width="1568" height="132" as="geometry"/></mxCell>
        <mxCell id="m32" value="RELIABILITY ENGINEERING" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k33" value="&lt;b&gt;Wear-out hazard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;damage raises the chance&lt;br&gt;of a fault, as in a real engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4551C0;strokeWidth=1.5;fontSize=11;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="32" y="540" width="372" height="68" as="geometry"/></mxCell>
        <mxCell id="k34" value="&lt;b&gt;Rate, not just state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;the model tracks how fast&lt;br&gt;health is falling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4551C0;strokeWidth=1.5;fontSize=11;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="416" y="540" width="372" height="68" as="geometry"/></mxCell>
        <mxCell id="k35" value="&lt;b&gt;Condition becomes warning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;current health carries&lt;br&gt;information about the future&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4551C0;strokeWidth=1.5;fontSize=11;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="372" height="68" as="geometry"/></mxCell>
        <mxCell id="k36" value="&lt;b&gt;Hours of notice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;enough time to schedule&lt;br&gt;rather than react&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4551C0;strokeWidth=1.5;fontSize=11;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1184" y="540" width="372" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
