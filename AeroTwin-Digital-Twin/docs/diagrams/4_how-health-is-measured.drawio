  <diagram name="4 How Health Is Measured" id="pg-4-how-health-is-measured">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr1" value="HOW HEALTH IS MEASURED  —  THE RESIDUAL IDEA  |  PS 26054" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="46" as="geometry"/></mxCell>
        <mxCell id="m2" value="A READING ON ITS OWN SAYS NOTHING" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#9DB4CC;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1054" y="13" width="430" height="20" as="geometry"/></mxCell>
        <mxCell id="k3" value="&lt;b&gt;SAME FLIGHT CONDITIONS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;throttle  ·  altitude  ·  airspeed  ·  outside air temperature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF2F5;strokeColor=#44566B;strokeWidth=1.5;fontSize=14;fontColor=#44566B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="76" width="760" height="56" as="geometry"/></mxCell>
        <mxCell id="k4" value="&lt;b&gt;REAL ENGINE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#5D6B66&quot;&gt;in service, 900 hours flown&lt;br&gt;&lt;br&gt;cylinder head temperature MEASURED:   112 °C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F0F9;strokeColor=#286BCC;strokeWidth=1.5;fontSize=15;fontColor=#286BCC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="186" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="k5" value="&lt;b&gt;PHYSICS TWIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#5D6B66&quot;&gt;as-new reference, same conditions&lt;br&gt;&lt;br&gt;cylinder head temperature EXPECTED:   103 °C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EC;strokeColor=#1B9949;strokeWidth=1.5;fontSize=15;fontColor=#1B9949;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="186" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="k6" value="&lt;b&gt;THE DIFFERENCE  =  + 9 °C&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#5D6B66&quot;&gt;not a limit breach, but this engine is running hotter than it should for this operating point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F1EF;strokeColor=#0D8B7C;strokeWidth=1.5;fontSize=17;fontColor=#0D8B7C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="396" width="640" height="92" as="geometry"/></mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#286BCC;strokeWidth=2.5;dashed=0;fontSize=9;fontColor=#286BCC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1B9949;strokeWidth=2.5;dashed=0;fontSize=9;fontColor=#1B9949;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k9" value="&lt;b&gt;WHAT is wrong&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;cooling path degradation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#773CAC;strokeWidth=1.5;fontSize=14;fontColor=#773CAC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="558" width="400" height="86" as="geometry"/></mxCell>
        <mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=2;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k11" value="&lt;b&gt;HOW BAD it is&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;health index and trend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4551C0;strokeWidth=1.5;fontSize=14;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="558" width="400" height="86" as="geometry"/></mxCell>
        <mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=2;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k13" value="&lt;b&gt;HOW LONG you have&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;remaining life and probability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E9E8C;strokeWidth=1.5;fontSize=14;fontColor=#0E9E8C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="558" width="400" height="86" as="geometry"/></mxCell>
        <mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=2;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k15" value="&lt;b&gt;This is why a limit-based system misses degradation.  112 °C is well inside every red line, so no threshold fires.  It is only wrong RELATIVE to what this engine should be doing today.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#14212F;strokeWidth=1.5;fontSize=12;fontColor=#14212F;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="692" width="1200" height="66" as="geometry"/></mxCell>
        <mxCell id="m16" value="REAL-TIME ENGINE STATE ESTIMATION  ·  DEGRADATION TRACKING  ·  MONITORING OF ENGINE HEALTH INDICATORS" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fontColor=#0E7F70;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="150" y="778" width="1200" height="16" as="geometry"/></mxCell>
      </root>
