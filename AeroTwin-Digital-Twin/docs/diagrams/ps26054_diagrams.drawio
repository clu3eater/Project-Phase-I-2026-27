  <diagram name="1 Problem and Solution" id="pg-1-problem-and-solution">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hdr1" value="THE PROBLEM TODAY, AND WHAT WE PROPOSE  |  PS 26054" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="46" as="geometry"/></mxCell>
        <mxCell id="m2" value="REACTIVE MONITORING  -&gt;  PREDICTIVE DIGITAL TWIN" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#9DB4CC;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1154" y="13" width="430" height="20" as="geometry"/></mxCell>
        <mxCell id="g3" value="A  ·  HOW ENGINE MONITORING WORKS TODAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#C0392B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="62" width="1568" height="252" as="geometry"/></mxCell>
        <mxCell id="m4" value="THRESHOLD-BASED  |  REACTIVE  |  AFTER THE FACT" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k5" value="&lt;b&gt;Engine runs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;wear accumulates quietly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44566B;strokeWidth=1.5;fontSize=12;fontColor=#44566B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="k6" value="&lt;b&gt;Sensor reads a value&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;RPM, CHT, EGT, oil pressure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44566B;strokeWidth=1.5;fontSize=12;fontColor=#44566B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="112" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="k7" value="&lt;b&gt;Compare to a fixed limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;is the value over the line?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44566B;strokeWidth=1.5;fontSize=12;fontColor=#44566B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="112" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="k8" value="&lt;b&gt;Alarm raised&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;after the damage is done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.5;fontSize=12;fontColor=#C0392B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="112" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8899AB;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#8899AB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k7" target="k8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k12" value="&lt;b&gt;The gap:  a limit is only crossed once damage has already happened.  Nothing here watches how the engine is CHANGING, so degradation stays invisible until it becomes a fault.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF5F4;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#C0392B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1520" height="46" as="geometry"/></mxCell>
        <mxCell id="k13" value="&lt;b&gt;What it costs:  mission aborts, unplanned maintenance, and in the worst case the loss of a high-value ISR aircraft.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44566B;strokeWidth=1.5;fontSize=11;fontColor=#44566B;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="256" width="1520" height="42" as="geometry"/></mxCell>
        <mxCell id="g14" value="B  ·  HOW OUR DIGITAL TWIN WORKS INSTEAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F1;strokeColor=#0D8B7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3D4A45;arcSize=6;" vertex="1" parent="1"><mxGeometry x="16" y="330" width="1568" height="248" as="geometry"/></mxCell>
        <mxCell id="m15" value="PREDICTIVE  |  PHYSICS-INFORMED  |  EXPLAINABLE" style="text;html=1;align=right;verticalAlign=middle;fontSize=8;fontColor=#6B7C86;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="338" width="352" height="16" as="geometry"/></mxCell>
        <mxCell id="k16" value="&lt;b&gt;Engine and FADEC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;CAN bus telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#526076;strokeWidth=1.5;fontSize=11;fontColor=#526076;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="34" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="k17" value="&lt;b&gt;Physics twin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;what an as-new engine&lt;br&gt;would do now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#286BCC;strokeWidth=1.5;fontSize=11;fontColor=#286BCC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="k18" value="&lt;b&gt;The difference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;measured minus expected&lt;br&gt;this is health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6F5;strokeColor=#0D8B7C;strokeWidth=1.5;fontSize=11;fontColor=#0D8B7C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="546" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="k19" value="&lt;b&gt;AI and ML layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;anomaly, fault class,&lt;br&gt;remaining life&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F1F9;strokeColor=#773CAC;strokeWidth=1.5;fontSize=11;fontColor=#773CAC;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="802" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="k20" value="&lt;b&gt;Failure probability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;will it last the&lt;br&gt;next sortie?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F2FA;strokeColor=#4551C0;strokeWidth=1.5;fontSize=11;fontColor=#4551C0;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1058" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="k21" value="&lt;b&gt;Maintenance advisory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-weight:normal;color:#5D6B66&quot;&gt;what to do,&lt;br&gt;and by when&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F6;strokeColor=#0E9E8C;strokeWidth=1.5;fontSize=11;fontColor=#0E9E8C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1314" y="380" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="f22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k16" target="k17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k17" target="k18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k18" target="k19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k19" target="k20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0D8B7C;strokeWidth=1.5;dashed=0;fontSize=9;fontColor=#0D8B7C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k20" target="k21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k27" value="&lt;b&gt;Warning arrives in HOURS, not seconds.  Maintenance is planned instead of reacted to, and a commander gets a straight answer before the aircraft leaves the ground.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8F7;strokeColor=#0D8B7C;strokeWidth=1.5;fontSize=11;fontColor=#0D8B7C;align=center;verticalAlign=middle;arcSize=14;" vertex="1" parent="1"><mxGeometry x="34" y="472" width="1532" height="46" as="geometry"/></mxCell>
