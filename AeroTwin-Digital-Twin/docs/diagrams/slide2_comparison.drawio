<mxfile host="app.diagrams.net" agent="PS26054" version="24.0.0">
  <diagram name="Slide 2 - The Comparison" id="ps26054-compare">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== INPUT ===== -->
        <mxCell id="inp" value="SAME FLIGHT CONDITIONS&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;throttle &#160;&#183;&#160; altitude &#160;&#183;&#160; airspeed &#160;&#183;&#160; outside air temperature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF1F0;strokeColor=#8A968F;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#3D4A45;" vertex="1" parent="1">
          <mxGeometry x="170" y="24" width="560" height="56" as="geometry" />
        </mxCell>

        <!-- ===== TWO ENGINES ===== -->
        <mxCell id="real" value="REAL ENGINE&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#3D4A45&quot;&gt;in service, 1200 hours flown&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:26px;font-weight:bold;color:#14181A&quot;&gt;112 &#176;C&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;MEASURED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2ECF6;strokeColor=#3E7CB1;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1B4F8A;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="140" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="twin" value="TWIN ENGINE (SOFTWARE)&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#3D4A45&quot;&gt;always factory condition&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:26px;font-weight:bold;color:#14181A&quot;&gt;104 &#176;C&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#5D6B66&quot;&gt;PREDICTED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0EFE5;strokeColor=#3F9E6B;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1F6B3D;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="140" width="300" height="140" as="geometry" />
        </mxCell>

        <!-- ===== THE FOCAL POINT ===== -->
        <mxCell id="diff" value="DIFFERENCE = 8 &#176;C&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#3A2005&quot;&gt;this is the wear, with the operator&#39;s actions removed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A24A;strokeColor=#B5620F;strokeWidth=3;fontSize=24;fontStyle=1;fontColor=#3A2005;" vertex="1" parent="1">
          <mxGeometry x="230" y="350" width="440" height="86" as="geometry" />
        </mxCell>

        <!-- ===== TWO OUTCOMES ===== -->
        <mxCell id="old" value="CONVENTIONAL MONITOR&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#6B7570&quot;&gt;certified limit is 135 &#176;C&lt;br&gt;112 is within limits&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px;font-weight:bold;color:#6B7570&quot;&gt;NO WARNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF1F0;strokeColor=#B8BEBB;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6B7570;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="new" value="OUR DIGITAL TWIN&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#2C3733&quot;&gt;cooling loss detected&lt;br&gt;schedule maintenance&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px;font-weight:bold;color:#0B5340&quot;&gt;EARLY WARNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0EFE5;strokeColor=#3F9E6B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1F6B3D;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="340" height="140" as="geometry" />
        </mxCell>

        <!-- ===== FOOTER ===== -->
        <mxCell id="foot" value="Detected while every certified limit is still satisfied." style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#5D6B66;" vertex="1" parent="1">
          <mxGeometry x="150" y="656" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e_inp_real" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inp" target="real"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inp_twin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inp" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_real_diff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="real" target="diff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_twin_diff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="twin" target="diff"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_diff_old" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="diff" target="old"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_diff_new" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14181A;strokeWidth=1.5;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="diff" target="new"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- annotation on the cancelling effect -->
        <mxCell id="note" value="the operator&#39;s actions&lt;br&gt;move BOTH models,&lt;br&gt;so they cancel out" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#5D6B66;" vertex="1" parent="1">
          <mxGeometry x="370" y="296" width="160" height="46" as="geometry" />
